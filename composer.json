{
    "name": "jeanpierregassin/lara-vellum",
    "description": "Laravel meets Vellum: the art of writing, as a Laravel package.",
    "keywords": [
        "laravel",
        "lara-vellum",
        "vellum",
        "writing"
    ],
    "homepage": "https://github.com/Jean-PierreGassin/lara-vellum",
    "license": "MIT",
    "authors": [
        {
            "name": "Jean-Pierre Gassin",
            "email": "jeanpierre.gassin@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "JeanPierreGassin\\LaraVellum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeanPierreGassin\\LaraVellum\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "php-cs-fixer fix",
        "lint": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeanPierreGassin\\LaraVellum\\LaraVellumServiceProvider"
            ],
            "aliases": {
                "LaraVellum": "JeanPierreGassin\\LaraVellum\\Facades\\LaraVellum"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
